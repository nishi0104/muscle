# ===== API キー =====
GEMINI_API_KEY=
FAL_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# ===== 使うサービス（auto: キーがあれば有料 API、無ければ無料の代替） =====
# IMAGE: gemini / pollinations(無料)   VIDEO: fal / slideshow(無料)   TTS: elevenlabs / say(無料・Mac)
IMAGE_PROVIDER=auto
VIDEO_PROVIDER=auto
TTS_PROVIDER=auto
# say の声（Kyoko=女性, Otoya=男性）と速さ
SAY_VOICE=Kyoko
SAY_RATE=200

# ===== モデル ID（廃止に備えてコードにハードコードしない） =====
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
FAL_VIDEO_MODEL=fal-ai/kling-video/v1/standard/image-to-video
FAL_VIDEO_DURATION=5
# モデル固有の追加引数（JSON）。例: {"aspect_ratio":"9:16"}
FAL_VIDEO_EXTRA_ARGS={}
ELEVENLABS_MODEL=eleven_multilingual_v2

# ===== 動画設定 =====
MAX_TOTAL_SEC=60
# 日本語フォント（未指定なら OS 標準の候補から自動検出）
FONT_PATH=
# BGM（任意）
BGM_PATH=
BGM_VOLUME=0.12
# ffmpeg のパス（未指定なら PATH → imageio-ffmpeg の順で探索）
FFMPEG_BIN=

# ===== YouTube =====
YOUTUBE_CLIENT_SECRETS=client_secret.json
YOUTUBE_TOKEN_PATH=youtube_token.json
# private / unlisted / public
YOUTUBE_PRIVACY=private

# 1 にすると外部 API を呼ばずダミー素材で全工程を通す（動作確認用）
PIPELINE_MOCK=0
